<?xml version="1.0" encoding="utf-8"?>
<!--
    Veritas Bible 자동 백업 정책 (API < 31).

    이 앱은 자체 암호화 백업(설정 > 백업 데이터 텍스트 복사) 워크플로를 통해
    사용자 데이터를 비밀번호 기반 AES 로 보호한다. 따라서 평문 형태로 Google
    Drive 자동 백업에 사용자 데이터가 올라가는 것을 방지하기 위해 모든 데이터
    도메인을 백업 대상에서 제외한다.

    제외 대상:
    - sharedpref: veritas_bible_prefs (테마/언어/온보딩 등)
    - database: veritas_bible.db (성경 본문 prepopulate + 사용자 노트·연구 데이터)
    - 그 외 file/external 도메인 전체
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
