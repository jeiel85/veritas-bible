<?xml version="1.0" encoding="utf-8"?>
<!--
    Veritas Bible 데이터 추출 정책 (API 31+).

    AI/외부 서비스 의존 없는 로컬 우선 정책을 그대로 따른다. 사용자가 만든
    암호화 백업(설정 > 백업 데이터 텍스트 복사) 외에는 어떤 데이터도
    클라우드 자동 백업이나 기기 간 전송으로 흘러가지 않게 모든 도메인을
    명시적으로 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
